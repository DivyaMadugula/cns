import java.util.*;

class RC4 {
    static String rc4(String text, String key) {
        int[] s = new int[256];
        int j = 0;

        for (int i = 0; i < 256; i++)
            s[i] = i;

        for (int i = 0; i < 256; i++) {
            j = (j + s[i] + key.charAt(i % key.length())) % 256;
            int t = s[i];
            s[i] = s[j];
            s[j] = t;
        }

        String out = "";
        int i = 0;
        j = 0;

        for (char ch : text.toCharArray()) {
            i = (i + 1) % 256;
            j = (j + s[i]) % 256;

            int t = s[i];
            s[i] = s[j];
            s[j] = t;

            int k = s[(s[i] + s[j]) % 256];
            out += (char) (ch ^ k);
        }

        return out;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text: ");
        String text = sc.nextLine();

        System.out.print("Enter key: ");
        String key = sc.nextLine();

        if (key.isEmpty()) {
            System.out.println("Key cannot be empty!");
            return;
        }

        String enc = rc4(text, key);
        String dec = rc4(enc, key);

        System.out.print("Encrypted (Hex): ");
        for (char c : enc.toCharArray())
            System.out.printf("%02X", (int) c);

        System.out.println();
        System.out.println("Decrypted: " + dec);
    }
}
