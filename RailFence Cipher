
import java.util.*;

class RailFence {
    static String encrypt(String s, int n) {
        String r = "";
        for (int row = 0; row < n; row++) {
            for (int i = row; i < s.length(); i += 2 * (n - 1)) {
                r += s.charAt(i);
                int j = i + 2 * (n - 1 - row);
                if (row != 0 && row != n - 1 && j < s.length())
                    r += s.charAt(j);
            }
        }
        return r;
    }

    static String decrypt(String s, int n) {
        int len = s.length();
        char[][] a = new char[n][len];
        for (char[] row : a) Arrays.fill(row, '\0');

        int row = 0, dir = 1;
        for (int i = 0; i < len; i++) {
            a[row][i] = '*';
            if (row == 0) dir = 1;
            else if (row == n - 1) dir = -1;
            row += dir;
        }

        int k = 0;
        for (int i = 0; i < n; i++)
            for (int j = 0; j < len; j++)
                if (a[i][j] == '*' && k < len)
                    a[i][j] = s.charAt(k++);

        String r = "";
        row = 0;
        dir = 1;
        for (int i = 0; i < len; i++) {
            r += a[row][i];
            if (row == 0) dir = 1;
            else if (row == n - 1) dir = -1;
            row += dir;
        }
        return r;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text: ");
        String s = sc.nextLine().replaceAll("\\s+", "");

        System.out.print("Enter number of rails: ");
        int n = sc.nextInt();

        if (n < 2 || n >= s.length()) {
            System.out.println("Rails must be between 2 and text length - 1.");
            return;
        }

        String e = encrypt(s, n);
        System.out.println("Encrypted: " + e);
        System.out.println("Decrypted: " + decrypt(e, n));
    }
}
