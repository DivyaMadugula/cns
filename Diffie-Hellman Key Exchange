import java.util.*;

class DiffieHellman {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int p = 23, g = 5;

        System.out.print("Enter Alice's private key: ");
        int a = sc.nextInt();

        System.out.print("Enter Bob's private key: ");
        int b = sc.nextInt();

        int A = 1, B = 1;

        for (int i = 0; i < a; i++)
            A = (A * g) % p;

        for (int i = 0; i < b; i++)
            B = (B * g) % p;

        int key1 = 1, key2 = 1;

        for (int i = 0; i < a; i++)
            key1 = (key1 * B) % p;

        for (int i = 0; i < b; i++)
            key2 = (key2 * A) % p;

        System.out.println("Alice's public key: " + A);
        System.out.println("Bob's public key: " + B);
        System.out.println("Alice's shared key: " + key1);
        System.out.println("Bob's shared key: " + key2);
    }
}
