
import java.util.*;

class HillCipher {
    static int[][] key = {{3, 3}, {2, 5}};

    static String encrypt(String s) {
        s = s.toUpperCase().replaceAll("[^A-Z]", "");
        if (s.length() % 2 != 0) s += "X";

        String r = "";
        for (int i = 0; i < s.length(); i += 2) {
            int x = s.charAt(i) - 'A';
            int y = s.charAt(i + 1) - 'A';

            r += (char) ((key[0][0] * x + key[0][1] * y) % 26 + 'A');
            r += (char) ((key[1][0] * x + key[1][1] * y) % 26 + 'A');
        }
        return r;
    }

    static String decrypt(String s) {
        String r = "";
        int[][] inv = {{15, 17}, {20, 9}};

        for (int i = 0; i < s.length(); i += 2) {
            int x = s.charAt(i) - 'A';
            int y = s.charAt(i + 1) - 'A';

            r += (char) ((inv[0][0] * x + inv[0][1] * y) % 26 + 'A');
            r += (char) ((inv[1][0] * x + inv[1][1] * y) % 26 + 'A');
        }
        return r;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text: ");
        String s = sc.nextLine();

        String e = encrypt(s);
        System.out.println("Encrypted: " + e);
        System.out.println("Decrypted: " + decrypt(e));
    }
}
